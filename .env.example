# Leave everything empty to run the fully offline demo mode.

# Supabase (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials)
# Web client ID is also entered in Supabase → Auth → Providers → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# RevenueCat (Project → API keys → public app-specific keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Login per SMS kostet pro Nachricht Geld (Twilio o. Ä. in Supabase nötig). Auf "true" setzen, um ihn anzuzeigen.
EXPO_PUBLIC_ENABLE_PHONE_LOGIN=false
